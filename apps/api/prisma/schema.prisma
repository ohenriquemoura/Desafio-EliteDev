generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ORGANIZER
  CLIENT
  GATE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum ReservationStatus {
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  EXPIRED
}

enum TicketStatus {
  ISSUED
  USED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizedEvents Event[]       @relation("OrganizerEvents")
  reservations    Reservation[]
  tickets         Ticket[]

  @@map("users")
}

model Event {
  id          String      @id @default(uuid()) @db.Uuid
  organizerId String      @db.Uuid
  organizer   User        @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Restrict)
  tmdbMovieId Int
  title       String
  posterPath  String?
  overview    String?
  venue       String
  startsAt    DateTime
  capacity    Int
  /// Unidades em reserva pendente de pagamento
  heldCount   Int         @default(0)
  /// Unidades pagas / convertidas em ingresso
  soldCount   Int         @default(0)
  priceCents  Int
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  reservations Reservation[]
  tickets      Ticket[]

  @@index([status, startsAt])
  @@index([organizerId])
  @@map("events")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  eventId     String            @db.Uuid
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Restrict)
  clientId    String            @db.Uuid
  client      User              @relation(fields: [clientId], references: [id], onDelete: Restrict)
  quantity    Int
  status      ReservationStatus @default(PENDING_PAYMENT)
  amountCents Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  expiresAt   DateTime?

  tickets Ticket[]

  @@index([eventId, status])
  @@index([clientId])
  @@map("reservations")
}

model Ticket {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @db.Uuid
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  reservationId String       @db.Uuid
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  clientId      String       @db.Uuid
  client        User         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  /// Código opaco verificável (HMAC); exibido no QR
  code          String       @unique
  /// Token para link público de compartilhamento
  shareToken    String       @unique
  status        TicketStatus @default(ISSUED)
  usedAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([eventId, status])
  @@index([clientId])
  @@map("tickets")
}

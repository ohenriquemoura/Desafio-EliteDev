# PostgreSQL (docker compose)
POSTGRES_USER=elitedev
POSTGRES_PASSWORD=elitedev
POSTGRES_DB=elitedev
POSTGRES_PORT=5432

# API (NestJS)
# Local (npm run dev:api): use localhost
# Docker Compose sobrescreve DATABASE_URL para o host "postgres"
DATABASE_URL=postgresql://elitedev:elitedev@localhost:5432/elitedev
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-in-local-dev
TICKET_HMAC_SECRET=change-me-ticket-hmac
TMDB_API_KEY=

# Web (Next.js)
WEB_PORT=3000
# URL usada pelo browser para chamar a API (também no build da imagem web)
NEXT_PUBLIC_API_URL=http://localhost:3001
